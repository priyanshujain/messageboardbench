root := "../.."

start:
    cd {{root}} && .venv/bin/python scripts/prepare_swe_population_v3.py --pool experiments/swe-population-pilot-10-v3/candidate-pool.json --template experiments/swe-population-pilot-10-v3/plan.json --screen-root work/swe-population-pilot-10-v3-validation --derived-plan work/swe-population-pilot-10-v3-validation/execution-plan.json --validate-only
    cd {{root}} && .venv/bin/python scripts/remote_docker.py -- .venv/bin/python scripts/prepare_swe_population_v3.py --pool experiments/swe-population-pilot-10-v3/candidate-pool.json --template experiments/swe-population-pilot-10-v3/plan.json --screen-root work/swe-population-pilot-10-v3-validation --derived-plan work/swe-population-pilot-10-v3-validation/execution-plan.json
    cd {{root}} && .venv/bin/python scripts/run_experiment_bundle.py --bundle experiments/swe-population-pilot-10-v3

validate:
    cd {{root}} && .venv/bin/python scripts/prepare_swe_population_v3.py --pool experiments/swe-population-pilot-10-v3/candidate-pool.json --template experiments/swe-population-pilot-10-v3/plan.json --screen-root work/swe-population-pilot-10-v3-validation --derived-plan work/swe-population-pilot-10-v3-validation/execution-plan.json --validate-only
    cd {{root}} && .venv/bin/python scripts/run_experiment_bundle.py --bundle experiments/swe-population-pilot-10-v3 --validate-only
